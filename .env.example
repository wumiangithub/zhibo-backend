VHALL_APP_KEY=
VHALL_APP_SECRET=
# 微吼回调校签私钥（设置回调事件时的 secret_key）；空则回退 VHALL_APP_SECRET
VHALL_CALLBACK_SECRET=

# 火山引擎 TOS / STS（管理端浏览器直传；见 zhibo-shared/docs/API约定.md）
# 非密钥写 .env；AK/SK 务必写 .env.local（GitHub push protection 会拦 Access Key）
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_STS_ROLE_TRN=trn:iam::2116729154:role/sts
VOLC_TOS_REGION=cn-shanghai
VOLC_TOS_ENDPOINT=tos-cn-shanghai.volces.com
# local/uat: qky-live-sucai-test；prod: qky-live-sucai-prod
VOLC_TOS_BUCKET=qky-live-sucai-test
VOLC_STS_DURATION_SECONDS=3600
# 访问 URL 前缀（观众头像等落库拼 CDN）；local/uat：https://qklive-testcos.cjs99.com
VOLC_TOS_CDN_URL=https://qklive-testcos.cjs99.com

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zhibo
MYSQL_USER=root
MYSQL_PASSWORD=

# 管理端登录（D41；Secret/密钥务必写 .env.local，勿进 git）
# 详见 zhibo-shared/docs/管理端登录.md 、API约定「管理端登录」
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
# 本地对齐前端 Vite:80 代理，无端口：http://wx.qktz.com.cn/api/v1/auth/wechat/callback
WECHAT_OPEN_REDIRECT_URI=
# 口令传输 AES-256-GCM 密钥（Base64，32 字节）；写 .env.local，可与旧 base-admin 对齐
AUTH_PASSWORD_AES_KEY_BASE64=
# 售卖加密密码 AES-256-GCM 密钥（Base64，32 字节）；写 .env.local；勿复用 AUTH_PASSWORD_AES_KEY_BASE64
ACTIVITY_SELL_PASSWORD_AES_KEY_BASE64=
# 加密售卖本场访问 JWT（D90；复用 VIEWER_JWT_SECRET；aud 与观众登录分开）
VIEWER_ACTIVITY_ACCESS_AUDIENCE=activity-access
VIEWER_ACTIVITY_ACCESS_EXPIRE_SECONDS=86400
# JWT HMAC 密钥；写 .env.local，可与旧 base-admin AccessSecret 对齐
AUTH_JWT_SECRET=
# access 有效秒数；默认 7200（2 小时）
AUTH_JWT_EXPIRE_SECONDS=7200
# refresh 有效秒数；默认 604800（7 天）。见 D43 / API约定 POST /api/v1/auth/refresh
AUTH_JWT_REFRESH_EXPIRE_SECONDS=604800
# 可选；默认即旧 base-admin Issuer / Audience。refresh 的 aud 默认 base-refresh
AUTH_JWT_ISSUER=base-admin-api
AUTH_JWT_AUDIENCE=base
AUTH_JWT_REFRESH_AUDIENCE=base-refresh
# 本地开发临时：true=未绑定账号扫码后写库绑定 openid/unionid；默认 false（正式：未绑定仍报错）
# 仅写 .env.local，勿在生产开启
AUTH_WECHAT_ALLOW_SELF_BIND=false

# 观众登录（D73；小程序 AppSecret 与观众 JWT 务必写 .env.local，勿进 git，勿复用 AUTH_JWT_SECRET）
# 详见 zhibo-shared/docs/观众登录.md 、API约定「观众登录」
# 微信小程序 AppID（公开）。这是小程序渠道的配置，不是观众账号名
WECHAT_MP_APP_ID=wx8ba0027c2c9e839c
# 小程序 AppSecret；只写 .env.local，禁止进 git / 小程序包
WECHAT_MP_APP_SECRET=
# 观众 JWT HMAC 密钥；只写 .env.local，不要复用 AUTH_JWT_SECRET
VIEWER_JWT_SECRET=
# access 有效秒数；默认 7200（2 小时）
VIEWER_JWT_EXPIRE_SECONDS=7200
# refresh 有效秒数；默认 604800（7 天）
VIEWER_JWT_REFRESH_EXPIRE_SECONDS=604800
# 可选。access 的 aud 默认 viewer，refresh 的 aud 默认 viewer-refresh
VIEWER_JWT_ISSUER=zhibo-viewer
VIEWER_JWT_AUDIENCE=viewer
VIEWER_JWT_REFRESH_AUDIENCE=viewer-refresh
