VHALL_APP_KEY=
VHALL_APP_SECRET=
# 微吼回调校签私钥（设置回调事件时的 secret_key）；空则回退 VHALL_APP_SECRET
VHALL_CALLBACK_SECRET=

# 火山引擎 TOS / STS（管理端浏览器直传；见 zhibo-shared/docs/API约定.md）
# 非密钥写 .env；AK/SK 务必写 .env.local（GitHub push protection 会拦 Access Key）
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_STS_ROLE_TRN=trn:iam::2116729154:role/sts
VOLC_TOS_REGION=cn-shanghai
VOLC_TOS_ENDPOINT=tos-cn-shanghai.volces.com
# 本文件是本地默认：qky-live-sucai-test。uat 部署改 qky-live-sucai-uat；prod 改 qky-live-sucai-prod
VOLC_TOS_BUCKET=qky-live-sucai-test
VOLC_STS_DURATION_SECONDS=3600
# 访问 URL 前缀（观众头像等落库）。本地/测试：https://qklive-testcos.cjs99.com
# uat 加速域名未下发前填 https://qky-live-sucai-uat.tos-cn-shanghai.volces.com
VOLC_TOS_CDN_URL=https://qklive-testcos.cjs99.com

# 默认头像底座公网 URL（D111；无 query）。签名时后端再拼 ?v=：观众数字 / 中控台 z{员工id} / 角色 e{员工id}
# 未配则用下方默认 TOS 地址
ZHIBO_DEFAULT_AVATAR_URL=https://qklive-testcos.cjs99.com/viewer/avatar/default-avatar.png

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zhibo
MYSQL_USER=root
MYSQL_PASSWORD=

# 本仓库两个 Java 进程共用这一份 .env，监听端口必须分开命名。
# 不要写 SERVER_PORT，否则两个服务会抢同一个口。未写时 admin 8081、live 8082。
ADMIN_SERVER_PORT=8081
LIVE_SERVER_PORT=8082

# 管理端登录（D41；Secret/密钥务必写 .env.local，勿进 git）
# 详见 zhibo-shared/docs/管理端登录.md 、API约定「管理端登录」
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
# 须与前端 VITE_WECHAT_REDIRECT_URI 同值；本地例：http://wx.qktz.com.cn/api/v1/auth/wechat/callback
# 测试例：https://wx.qktz.com.cn/live-admin/api/v1/auth/wechat/callback（非本机须 HTTPS）
WECHAT_OPEN_REDIRECT_URI=
# 口令传输 AES-256-GCM 密钥（Base64，32 字节）；写 .env.local，可与旧 base-admin 对齐
AUTH_PASSWORD_AES_KEY_BASE64=
# 售卖加密密码 AES-256-GCM 密钥（Base64，32 字节）；写 .env.local；勿复用 AUTH_PASSWORD_AES_KEY_BASE64
ACTIVITY_SELL_PASSWORD_AES_KEY_BASE64=
# 加密售卖本场访问 JWT（D90；复用 VIEWER_JWT_SECRET；aud 与观众登录分开）
VIEWER_ACTIVITY_ACCESS_AUDIENCE=activity-access
VIEWER_ACTIVITY_ACCESS_EXPIRE_SECONDS=86400
# 业务员 JWT HMAC；写 .env.local。须与订单中心 Authorization-Live-Saler 验签密钥一致（勿随机生成本地独用值）
AUTH_JWT_SECRET=
# access 有效秒数；默认 7200（2 小时）
AUTH_JWT_EXPIRE_SECONDS=7200
# refresh 有效秒数；默认 604800（7 天）。见 D43 / API约定 POST /api/v1/auth/refresh
AUTH_JWT_REFRESH_EXPIRE_SECONDS=604800
# 可选；默认即旧 base-admin Issuer / Audience。refresh 的 aud 默认 base-refresh
AUTH_JWT_ISSUER=base-admin-api
AUTH_JWT_AUDIENCE=base
AUTH_JWT_REFRESH_AUDIENCE=base-refresh
# 本地开发临时：true=未绑定账号扫码后写库绑定 openid/unionid；默认 false（正式：未绑定仍报错）
# 仅写 .env.local，勿在生产开启
AUTH_WECHAT_ALLOW_SELF_BIND=false
# 微信扫码轮询 GET /api/v1/auth/login/query 是否模拟扫码成功。按 Spring profile 给默认值：
#   local / test 默认 true；uat / prod 默认 false。
# 也可在对应环境用本变量覆盖。预发/生产即使误配为 true 也不会生效。
# 【强制】测试/预发/生产启动必须分别带 --spring.profiles.active=test|uat|prod（也可设 SPRING_PROFILES_ACTIVE）。
# 禁止沿用默认 local，否则会加载 application-local.yml，生产也会模拟扫码登录。环境名是 prod，不要写 production。
# 详见 ../zhibo-shared/docs/Spring环境与启动.md
# WECHAT_MOCK_SCAN_SUCCESS=

# 观众登录（D73；小程序 AppSecret 与观众 JWT 务必写 .env.local，勿进 git，勿复用 AUTH_JWT_SECRET）
# 详见 zhibo-shared/docs/观众登录.md 、API约定「观众登录」
# 微信小程序 AppID（公开）。这是小程序渠道的配置，不是观众账号名
WECHAT_MP_APP_ID=wx8ba0027c2c9e839c
# 小程序 AppSecret；只写 .env.local，禁止进 git / 小程序包
WECHAT_MP_APP_SECRET=
# 观众 JWT HMAC；只写 .env.local。须与订单中心 Authorization-Live-Viewers 验签密钥一致；
# 禁止随便随机生成；不要复用 AUTH_JWT_SECRET。改密钥后重启 live-service 并重新登录/refresh
VIEWER_JWT_SECRET=
# access 有效秒数；默认 7200（2 小时）
VIEWER_JWT_EXPIRE_SECONDS=7200
# refresh 有效秒数；默认 604800（7 天）
VIEWER_JWT_REFRESH_EXPIRE_SECONDS=604800
# 可选。access 的 aud 默认 viewer，refresh 的 aud 默认 viewer-refresh
VIEWER_JWT_ISSUER=zhibo-viewer
VIEWER_JWT_AUDIENCE=viewer
VIEWER_JWT_REFRESH_AUDIENCE=viewer-refresh
# 用户中心（钱坤云）微信注册 Base URL；按环境区分（D116）。测试示例：
# VIEWER_OAUTH_BASE_URL=http://119.3.31.54:8410/acctClientManagement/
# 生产域名另配。缺则正式微信/手机号登录不可用（local 明文手机号登录仍可）
VIEWER_OAUTH_BASE_URL=
# 可选覆盖；默认已与产品约定一致
# VIEWER_OAUTH_CHANNEL=钱坤云私域直播用户注册
# VIEWER_OAUTH_PROJECT_NAME=钱坤云私域直播
# VIEWER_OAUTH_PROJECT_CODE=qkysyzb

# OMS 只读库（直播带货「成功退款金额」）。账号仅 SELECT。
# 密码务必写 .env.local 或进程环境，勿把真实密码写进本文件或 git。
# 缺主机或密码时 admin-service 仍可启动，该列返回 "0.00"。
OMS_DB_HOST=mysql-8c1c7f5fabcf-public.rds.volces.com
OMS_DB_PORT=35846
OMS_DB_NAME=oms_db
OMS_DB_USER=pro_oms_zb_user
OMS_DB_PASSWORD=
